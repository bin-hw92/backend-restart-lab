# db:setup이 기존 Docker MySQL에 전용 DB/계정을 만들고 실제 .env를 생성합니다.
DATABASE_URL="mysql://nest_board_user:CHANGE_ME@127.0.0.1:3307/nest_board"
TEST_DATABASE_URL="mysql://nest_board_user:CHANGE_ME@127.0.0.1:3307/nest_board_test"
# PostgreSQL: postgresql://user:password@127.0.0.1:5432/database 형식으로 바꿉니다.
PORT=3100
